<mujoco model="floor and sky">

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
    </visual>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".075 .224 .325" rgb2=".208 .392 .537" width="512" height="512"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
    </asset>

    <worldbody>
        <light pos="1 -1 1.5" dir="-1 1 -1" diffuse="0.5 0.5 0.5" directional="true" />
        <geom name="floor" group="1" size="0 0 0.05" type="plane" material="grid" friction="1.0 0.005 0.001" solref="0.01 0.001" solimp="0.9 0.95 0.001 0.5 2"/>

        <!-- <geom name="floor" group="1" size="0 0 0.05" type="plane" material="grid" /> -->

    </worldbody>

</mujoco>
