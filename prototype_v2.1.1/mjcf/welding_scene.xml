<mujoco model="walking scene">

    <!-- Default options -->
    <compiler angle="radian" autolimits="true" />
    <!-- <option integrator="RK4" noslip_iterations="20" /> -->
    <option integrator="Euler" timestep="0.005" />
    <default>
        <joint armature="0.1" damping="0.1" />
        <default class="visual_only">
            <!-- visual group of 'collision' of 2 is to render -->
            <!-- All geoms with contype⁠=⁠conaffinity⁠=0 are discarded -->
            <geom type="mesh" contype="0" conaffinity="0" group="2" />
        </default>
        <default class="visual_collision">
            <!-- visual group of 'collision' of 2 is to render -->
            <geom type="mesh" solimp=".9 .99 .001" solref=".015 1" group="2" />
        </default>
        <default class="no_visual_collision">
            <!-- visual group of 'collision' of 3 is NOT to render -->
            <geom type="capsule" solimp=".9 .99 .001" solref=".015 1" group="3" />
        </default>
    </default>


  <include file="./prototype_v2.1.1.xml" />

  <!-- Floor and Sky -->
  <include file="./floor.xml" />


  <!-- Fixed U-shaped walls; dimensions are in meters.
       Inner faces: y = +/-0.200 (400 mm clearance).
       Side walls span x = -0.500 to 0.650 and meet the front wall.
       Front inner face: x = 0.650; width: 0.440.
       Thickness: 0.020; side height: 0.320; front height: 1.600.
       Box size values are half-extents; bottoms rest at z = 0. -->
  <worldbody>
    <geom name="wall_y_positive" type="box" pos="0.075 0.210 0.160"
          size="0.575 0.010 0.160" rgba="0.65 0.68 0.72 1"
          contype="1" conaffinity="1" group="1" />
    <geom name="wall_y_negative" type="box" pos="0.075 -0.210 0.160"
          size="0.575 0.010 0.160" rgba="0.65 0.68 0.72 1"
          contype="1" conaffinity="1" group="1" />
    <geom name="wall_x_front" type="box" pos="0.660 0 0.800"
          size="0.010 0.220 0.800" rgba="0.65 0.68 0.72 1"
          contype="1" conaffinity="1" group="1" />
  </worldbody>

</mujoco>
